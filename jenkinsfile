pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo '📥 Obteniendo código fuente del repositorio...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo '🏗️ Creando entorno virtual e instalando dependencias...'
                sh '''
                    python3 -m venv venv
                    ./venv/bin/pip install --upgrade pip
                    ./venv/bin/pip install -r requirements.txt
                '''
            }
        }

        stage('Test') {
            steps {
                echo '🧪 Ejecutando pruebas unitarias...'
                sh './venv/bin/pytest tests/ --cov=app'
            }
        }

        stage('Deploy Simulation') {
            steps {
                echo '🚀 Simulando despliegue...'
                echo "Versión desplegada: build #${env.BUILD_NUMBER}"
                echo '✅ Despliegue simulado exitosamente'
            }
        }
    }

    post {
        success {
            echo '✅ Pipeline completado exitosamente.'
        }
        failure {
            echo '❌ El pipeline ha fallado.'
        }
    }
}
